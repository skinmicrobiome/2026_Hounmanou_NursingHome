# Helper function for Figures 6F and 6H

library(ggplot2)
library(dplyr)
library(patchwork)

make_snp_pairwise_df <- function(snp_matrix_path, metadata_path) {
  snp_df <- read.csv(snp_matrix_path, row.names = 1, check.names = FALSE, stringsAsFactors = FALSE)
  snp_matrix <- as.matrix(snp_df)
  storage.mode(snp_matrix) <- "numeric"

  stopifnot(nrow(snp_matrix) == ncol(snp_matrix))
  stopifnot(identical(rownames(snp_matrix), colnames(snp_matrix)))

  sample_ids <- rownames(snp_matrix)

  metadata <- read.csv(metadata_path, stringsAsFactors = FALSE)
  stopifnot(all(c("sample_id", "subject_id", "facility_id") %in% names(metadata)))

  idx <- which(upper.tri(snp_matrix), arr.ind = TRUE)

  tibble(
    i = idx[, 1],
    j = idx[, 2],
    sample1 = sample_ids[i],
    sample2 = sample_ids[j],
    snp_distance = snp_matrix[cbind(idx[, 1], idx[, 2])]
  ) %>%
    left_join(
      metadata %>% select(sample_id, subject_id, facility_id),
      by = c("sample1" = "sample_id")
    ) %>%
    rename(subject1 = subject_id, facility1 = facility_id) %>%
    left_join(
      metadata %>% select(sample_id, subject_id, facility_id),
      by = c("sample2" = "sample_id")
    ) %>%
    rename(subject2 = subject_id, facility2 = facility_id) %>%
    mutate(
      pair_type = case_when(
        subject1 == subject2 ~ "Same Subject",
        subject1 != subject2 & facility1 == facility2 ~ "Different Subjects (Same Facility)",
        subject1 != subject2 & facility1 != facility2 ~ "Different Subjects (Different Facilities)",
        TRUE ~ NA_character_
      )
    ) %>%
    tidyr::drop_na(pair_type)
}
