    legend.position = "right",
    legend.title = element_text(size = 11),
    legend.text = element_text(size = 9),
    legend.key.size = unit(0.5, "cm"),
    legend.box = "vertical"
  ) +
  guides(fill = guide_legend(ncol = 1, reverse = FALSE))

