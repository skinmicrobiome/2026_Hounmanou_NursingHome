})

# Input files
csv_A      <- "<MAG_summary_table.csv>"          # MAG summary table corresponding to Supplementary Table S3
ps_rds     <- "<relative_abundance_phyloseq_object.rds>"
meta_csv_B <- "<metadata_file.csv>"              # Metadata file corresponding to Supplementary Table S1
img_C_path <- "<figure2_panelC_image.png>"       # Generated by the Figure 2C script chunk below

clean_label <- function(x) stringr::str_trim(x)

sort_subjects_numeric <- function(v) {
  u <- unique(v)
  dig <- gsub("[^0-9]", "", u)
  nums <- suppressWarnings(as.integer(dig))
  if (any(is.na(nums))) {
    u[order(clean_label(u), method = "radix")]
  } else {
    u[order(nums, method = "radix")]
  }
}

species_to_italic <- c(
  "Escherichia coli", "Klebsiella pneumoniae", "Pseudomonas aeruginosa",
  "Providencia stuartii", "Proteus mirabilis", "Enterococcus faecalis",
  "Staphylococcus aureus", "Staphylococcus epidermidis", "Staphylococcus pettenkoferi",
  "Morganella morganii", "Enterobacter cloacae",
  "Malassezia restricta", "Malassezia globosa", "Malassezia slooffiae"
)

italic_labels <- function(x) ifelse(x %in% species_to_italic, paste0("*", x, "*"), x)

# Load phyloseq object
ra <- readRDS(ps_rds)
stopifnot(inherits(ra, "phyloseq"))

tax_df <- as.data.frame(tax_table(ra))
colnames(tax_df) <- sub("^Domain$", "Kingdom", colnames(tax_df), ignore.case = TRUE)
colnames(tax_df) <- sub("^rank2$", "Phylum", colnames(tax_df), ignore.case = TRUE)

otu_df <- as.data.frame(otu_table(ra))
if (!taxa_are_rows(ra)) otu_df <- t(otu_df)

otu_df <- otu_df[match(rownames(tax_df), rownames(otu_df)), , drop = FALSE]

df <- cbind(tax_df, otu_df)
n_tax <- ncol(tax_df)

df_sorted <- df[
  order(rowSums(df[, (n_tax + 1):ncol(df)], na.rm = TRUE), decreasing = TRUE),
]

# Load metadata
ready_metadata <- read_csv(meta_csv_B, show_col_types = FALSE) |> as.data.frame()
stopifnot("library_id" %in% names(ready_metadata))

named_taxa <- species_to_italic

TargetLvl1_min <- function(df, mytab) {
  id_cols <- c("Kingdom", "Phylum", "Class", "Order", "Family", "Genus", "Species")

  df$Species <- gsub("_", " ", as.character(df$Species))

  long <- df |>
    pivot_longer(
      cols = setdiff(names(df), id_cols),
      names_to = "library_id",
      values_to = "value"
    )

  long$Target <- "Other taxa"

  map_set <- list(
    "Enterococcus faecalis"       = long$Genus == "Enterococcus"   & long$Species == "faecalis",
    "Staphylococcus pettenkoferi" = long$Genus == "Staphylococcus" & long$Species == "pettenkoferi",
    "Staphylococcus epidermidis"  = long$Genus == "Staphylococcus" & long$Species == "epidermidis",
    "Staphylococcus aureus"       = long$Genus == "Staphylococcus" & long$Species == "aureus",
    "Enterobacter cloacae"        = long$Genus == "Enterobacter"   & long$Species == "cloacae",
    "Morganella morganii"         = long$Genus == "Morganella"     & long$Species == "morganii",
    "Escherichia coli"            = long$Genus == "Escherichia"    & long$Species == "coli",
    "Proteus mirabilis"           = long$Genus == "Proteus"        & long$Species == "mirabilis",
    "Providencia stuartii"        = long$Genus == "Providencia"    & long$Species == "stuartii",
    "Pseudomonas aeruginosa"      = long$Genus == "Pseudomonas"    & long$Species == "aeruginosa",
    "Klebsiella pneumoniae"       = long$Genus == "Klebsiella"     & long$Species == "pneumoniae",
    "Malassezia restricta"        = long$Genus == "Malassezia"     & long$Species == "restricta",
    "Malassezia globosa"          = long$Genus == "Malassezia"     & long$Species == "globosa",
    "Malassezia slooffiae"        = long$Genus == "Malassezia"     & long$Species == "slooffiae"
  )

  for (nm in names(map_set)) {
    long$Target[map_set[[nm]]] <- nm
  }

  long$Target <- factor(long$Target, levels = c("Other taxa", named_taxa))

  out <- long |>
    group_by(library_id, Target) |>
    summarise(value = sum(value, na.rm = TRUE), .groups = "drop")

  md <- mytab |> distinct(library_id, .keep_all = TRUE)

  out <- left_join(out, md, by = "library_id")

  # Use anonymized subject IDs already provided in the metadata.
  out$subject_label <- clean_label(out$subject_id)

  out$site_specific <- recode(
    out$site_specific,
    "Ax" = "Axilla",
    "Ic" = "Inguinal Crease"
  )

  out
}

df3 <- TargetLvl1_min(df_sorted, ready_metadata)

# Panel A
A_df <- read.csv(csv_A, stringsAsFactors = FALSE) |>
  mutate(prok_species = trimws(prok_species)) |>
  filter(Completeness >= 50, Contamination <= 10) |>
  filter(!(site_specific %in% c("<control_code_1>", "<control_code_2>", "<control_code_3>"))) |>
  mutate(
    site_specific = recode(site_specific, "Ax" = "Axilla", "Ic" = "Inguinal Crease"),
    subject_label = clean_label(subject_id)
  )

desired_species_order <- species_to_italic

A_df <- A_df |>
  filter(!is.na(prok_species), prok_species %in% desired_species_order) |>
  mutate(prok_species = factor(prok_species, levels = rev(desired_species_order))) |>
  droplevels()

master_levels <- sort_subjects_numeric(unique(A_df$subject_label))
A_df$subject_label <- factor(A_df$subject_label, levels = master_levels)

# Panel B
B_df <- df3 |>
  select(subject_label, site_specific, Target, value) |>
  semi_join(
    A_df |> distinct(site_specific, subject_label),
    by = c("site_specific", "subject_label")
  )

B_df$subject_label <- factor(B_df$subject_label, levels = master_levels)

# Colors
custom_colors <- c(
  "Escherichia coli" = "red",
  "Klebsiella pneumoniae" = "#FBB4B9",
  "Pseudomonas aeruginosa" = "purple",
  "Providencia stuartii" = "#014914",
  "Proteus mirabilis" = "#B3FBCF",
  "Enterococcus faecalis" = "#A0CDF4",
  "Staphylococcus aureus" = "#3F007D",
  "Staphylococcus epidermidis" = "#06C9F9",
  "Staphylococcus pettenkoferi" = "#2320FB",
  "Morganella morganii" = "#C7EA46",
  "Enterobacter cloacae" = "#010149",
  "Malassezia restricta" = "#fa8ef8",
  "Malassezia globosa" = "#641E16",
  "Malassezia slooffiae" = "orange"
)

color_pall_mag <- c(
  "Other taxa" = "#fdfefe",
  custom_colors
)

common_theme <- theme_bw(base_size = 12) +
  theme(
    axis.title.x = element_blank(),
    axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5, size = 7),
    plot.margin = margin(0, 0, 0, 0)
  )

# Panel A plot
pA <- ggplot(A_df, aes(x = subject_label, y = prok_species, color = prok_species)) +
  geom_point(position = position_dodge(width = 0.25), alpha = 0.8, size = 5) +
  facet_grid(. ~ site_specific, scales = "free_x", space = "free_x") +
  scale_color_manual(values = custom_colors, guide = "none") +
  labs(x = "Subject ID", y = "Species") +
  common_theme +
  theme(
    axis.text.y = ggtext::element_markdown(size = 10, face = "plain"),
    strip.text = element_text(face = "bold", size = 12),
    panel.grid.major.x = element_line(color = "grey85"),
    panel.grid.major.y = element_line(color = "grey85"),
    panel.grid.minor = element_blank(),
    panel.spacing = unit(0.6, "lines"),
    plot.margin = margin(t = 0, r = 0, b = 10, l = 0)
  ) +
  scale_y_discrete(labels = italic_labels)

# Panel B plot
pB <- ggplot(B_df, aes(x = subject_label, y = value, fill = Target)) +
  geom_bar(stat = "identity", position = "fill", width = 0.8) +
  facet_grid(. ~ site_specific, scales = "free_x", space = "free_x") +
  scale_fill_manual(values = color_pall_mag, guide = "none", labels = italic_labels) +
  scale_y_continuous(
    breaks = c(0, 0.25, 0.5, 0.75, 1),
    labels = c("0", "", "50", "", "100"),
    limits = c(0, 1),
    expand = expansion(mult = c(0, 0))
  ) +
  ylab("Relative Abundance (%)") +
  common_theme +
  theme(
    panel.grid = element_blank(),
    panel.spacing = unit(0.6, "lines"),
    plot.margin = margin(t = 10, r = 0, b = 0, l = 0)
  )

# Align panels A and B
aligned <- align_plots(pA, pB, align = "v", axis = "lr")

labelA <- ggdraw() + draw_label("A", fontface = "bold", size = 14, x = 0, hjust = 0)
labelB <- ggdraw() + draw_label("B", fontface = "bold", size = 14, x = 0, hjust = 0)

rowA <- plot_grid(labelA, aligned[[1]], ncol = 2, rel_widths = c(0.03, 0.97), align = "h")
rowB <- plot_grid(labelB, aligned[[2]], ncol = 2, rel_widths = c(0.03, 0.97), align = "h")

# Import panel C
imgC <- image_read(img_C_path)
imgC <- image_background(imgC, "white") |>
  image_trim() |>
  image_trim()

target_right_px <- round(0.97 * 12 * 300)
imgC <- image_scale(imgC, as.character(target_right_px))

labelC <- ggdraw() + draw_label("C", fontface = "bold", size = 14, x = 0, hjust = 0)
panelC <- ggdraw() + draw_image(imgC, scale = 1)

rowC <- plot_grid(labelC, panelC, ncol = 2, rel_widths = c(0.03, 0.97), align = "h")

combined_fig2 <- plot_grid(
  rowA,
  rowB,
  rowC,
  ncol = 1,
  rel_heights = c(1, 1, 0.6),
  align = "v",
  axis = "l"
)

combined_fig2
