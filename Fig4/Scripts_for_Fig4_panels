# Figure 4A

library(ggplot2)
library(ggnetwork)
library(readxl)
library(reshape2)
library(igraph)
library(scales)

ani_file <- "<ecoli_ani_matrix_one_Subject.tsv>" 
metadata_file <- "<ANI_metadata_file.xlsx>" ==> Table S1

IMP <- read.delim(ani_file, header = TRUE, sep = "\t", row.names = 1)
rownames(IMP) <- trimws(rownames(IMP))
colnames(IMP) <- trimws(colnames(IMP))

IMP_long <- as.data.frame(as.table(as.matrix(IMP)))
colnames(IMP_long) <- c("V1", "V2", "ANI")
IMP_long <- subset(IMP_long, as.character(V1) != as.character(V2))

metadata <- read_excel(metadata_file)

IMP_long <- merge(IMP_long, metadata, by.x = "V1", by.y = "user_genome")
colnames(IMP_long)[4:9] <- c(
  "prok_species_1", "subject_id_1", "site_specific_1",
  "sample_id_1", "MLST_1", "Source_1"
)

IMP_long <- merge(IMP_long, metadata, by.x = "V2", by.y = "user_genome")
colnames(IMP_long)[10:15] <- c(
  "prok_species_2", "subject_id_2", "site_specific_2",
  "sample_id_2", "MLST_2", "Source_2"
)

ani_matrix <- acast(IMP_long, V1 ~ V2, value.var = "ANI")
ani_matrix[is.na(ani_matrix)] <- 0
ani_matrix[ani_matrix < 99.95] <- 0
ani_matrix[ani_matrix >= 99.95] <- 1

network <- graph_from_adjacency_matrix(
  ani_matrix,
  mode = "undirected",
  diag = FALSE
)

df <- merge(
  ggnetwork(network),
  metadata,
  by.x = "name",
  by.y = "user_genome",
  all.x = TRUE
)

# Use anonymized subject IDs already provided in the metadata.
df$subject_label <- factor(df$subject_id)

subject_colors <- setNames(
  scales::hue_pal()(length(levels(df$subject_label))),
  levels(df$subject_label)
)

p <- ggplot(df, aes(x = x, y = y, xend = xend, yend = yend)) +
  geom_edges(color = "grey50", alpha = 0.6, linewidth = 0.3) +
  geom_nodes(aes(color = subject_label, shape = as.factor(Source)), size = 2) +
  scale_color_manual(values = subject_colors, name = "Subject ID") +
  scale_shape_manual(values = c("MAG" = 16, "WGS" = 15), name = "Source") +
  theme_void() +
  coord_fixed() +
  theme(
    legend.position = "right",
    legend.box = "vertical",
    legend.box.just = "left",
    legend.spacing.y = unit(0.4, "cm"),
    legend.title = element_text(size = 9, face = "bold"),
    legend.text = element_text(size = 8),
    plot.margin = margin(1, 1, 1, 1)
  ) +
  guides(
    color = guide_legend(ncol = 4, title.position = "top"),
    shape = guide_legend(
      nrow = 1,
      title.position = "top",
      override.aes = list(size = 3)
    )
  )

print(p)

