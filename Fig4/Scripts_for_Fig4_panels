# Figure 4D

library(ggplot2)
library(dplyr)
library(patchwork)

path <- "<snp_distance_matrix_ST93.csv>" ==> Table S5
metadata_file <- "<sample_metadata_file.csv>" == Table S1

m <- read.csv(path, row.names = 1, check.names = FALSE, stringsAsFactors = FALSE)
m <- as.matrix(m)
storage.mode(m) <- "numeric"

stopifnot(nrow(m) == ncol(m))

rn <- rownames(m)
cn <- colnames(m)

if (!identical(rn, cn)) {
  m <- m[, rn, drop = FALSE]
}

stopifnot(identical(rownames(m), colnames(m)))

sample_ids <- rownames(m)

metadata <- read.csv(metadata_file, stringsAsFactors = FALSE)

stopifnot(all(c("sample_id", "subject_id", "facility_id") %in% names(metadata)))

idx <- which(upper.tri(m), arr.ind = TRUE)

pairwise_df <- tibble(
  i = idx[, 1],
  j = idx[, 2],
  sample1 = sample_ids[idx[, 1]],
  sample2 = sample_ids[idx[, 2]],
  snp_distance = m[cbind(idx[, 1], idx[, 2])]
) %>%
  left_join(
    metadata %>% select(sample_id, subject_id, facility_id),
    by = c("sample1" = "sample_id")
  ) %>%
  rename(subject1 = subject_id, facility1 = facility_id) %>%
  left_join(
    metadata %>% select(sample_id, subject_id, facility_id),
    by = c("sample2" = "sample_id")
  ) %>%
  rename(subject2 = subject_id, facility2 = facility_id) %>%
  mutate(
    pair_type = case_when(
      subject1 == subject2 ~ "Same Subject",
      subject1 != subject2 & facility1 == facility2 ~ "Different Subjects (Same Facility)",
      subject1 != subject2 & facility1 != facility2 ~ "Different Subjects (Different Facilities)",
      TRUE ~ NA_character_
    )
  ) %>%
  tidyr::drop_na(pair_type)

print(table(pairwise_df$pair_type, useNA = "ifany"))

fill_colors <- c(
  "Same Subject" = "#7605b2",
  "Different Subjects (Same Facility)" = "#7605b2",
  "Different Subjects (Different Facilities)" = "#7605b2"
)

p_same <- ggplot(
  filter(pairwise_df, pair_type == "Same Subject"),
  aes(x = snp_distance, fill = pair_type)
) +
  geom_histogram(binwidth = 5, boundary = 0, color = "black", alpha = 0.9, na.rm = TRUE) +
  geom_vline(xintercept = 30, linetype = "dashed", color = "#d73027", linewidth = 1.1) +
  scale_fill_manual(values = fill_colors) +
  scale_x_continuous(limits = c(0, 30), breaks = seq(0, 30, by = 5)) +
  labs(x = "SNP Distance", y = "Sample Pairs (Same Subject)") +
  theme_minimal(base_size = 15) +
  theme(
    panel.grid = element_blank(),
    axis.line = element_line(color = "black"),
    axis.text.x = element_text(face = "bold"),
    axis.text.y = element_text(face = "bold"),
    legend.position = "none"
  )

p_same_fac <- ggplot(
  filter(pairwise_df, pair_type == "Different Subjects (Same Facility)"),
  aes(x = snp_distance, fill = pair_type)
) +
  geom_histogram(binwidth = 10, boundary = 0, color = "black", alpha = 0.9, na.rm = TRUE) +
  geom_vline(xintercept = 30, linetype = "dashed", color = "#d73027", linewidth = 1.1) +
  scale_fill_manual(values = fill_colors) +
  labs(x = "SNP Distance", y = "Sample Pairs (Diff Subj, Same Fac)") +
  theme_minimal(base_size = 15) +
  theme(
    panel.grid = element_blank(),
    axis.line = element_line(color = "black"),
    axis.text.x = element_text(face = "bold"),
    axis.text.y = element_text(face = "bold"),
    legend.position = "none"
  )

p_diff_fac <- ggplot(
  filter(pairwise_df, pair_type == "Different Subjects (Different Facilities)"),
  aes(x = snp_distance, fill = pair_type)
) +
  geom_histogram(binwidth = 10, boundary = 0, color = "black", alpha = 0.9, na.rm = TRUE) +
  geom_vline(xintercept = 30, linetype = "dashed", color = "#d73027", linewidth = 1.1) +
  scale_fill_manual(values = fill_colors) +
  labs(x = "SNP Distance", y = "Sample Pairs (Diff Subj, Diff Fac)") +
  theme_minimal(base_size = 15) +
  theme(
    panel.grid = element_blank(),
    axis.line = element_line(color = "black"),
    axis.text.x = element_text(face = "bold"),
    axis.text.y = element_text(face = "bold"),
    legend.position = "none"
  )

final_plot_st93 <- p_same + p_same_fac + p_diff_fac +
  plot_layout(ncol = 3, widths = c(1, 1, 1)) &
  theme(
    plot.margin = margin(10, 15, 10, 15),
    axis.title.y = element_text(margin = margin(r = 5))
  )

final_plot_st93

