# Fig 3A
```{r}
library(ggplot2)
library(dplyr)
library(readxl)

mags_data <- read.csv("<MAG_summary_table.csv>") # MAG summary table corresponding to Supplementary Table S3
wgs_shared_data <- read_excel("<isolate_WGS_metadata_table.xlsx>") # Isolate WGS metadata table corresponding to Supplementary Table S2

selected_species <- c("Escherichia coli")
selected_sites <- c("Ic_Ax")

mags_data <- mags_data %>%
  mutate(site_specific = ifelse(site_specific %in% c("Ic", "Ax"), "Ic_Ax", site_specific))

wgs_shared_data <- wgs_shared_data %>%
  mutate(site_specific = ifelse(site_specific %in% c("Ic", "Ax"), "Ic_Ax", site_specific))

wgs_shared_data_filtered <- wgs_shared_data %>%
  filter(species %in% selected_species, site_specific %in% selected_sites)

mags_filtered <- mags_data %>%
  filter(prok_species %in% selected_species, site_specific %in% selected_sites)

combined_data <- mags_filtered %>%
  select(subject_id, prok_species, site_specific) %>%
  mutate(data_type = "MAG") %>%
  rename(species = prok_species) %>%
  bind_rows(
    wgs_shared_data_filtered %>%
      select(subject_id, species, site_specific) %>%
      mutate(data_type = "WGS")
  )

combined_data <- combined_data %>%
  mutate(
    # Use anonymized subject IDs already provided in the released tables.
    subject_label = subject_id,
    species = factor(species, levels = selected_species)
  )

# Optional: exclude external subjects if needed.
combined_data <- combined_data %>%
  filter(!subject_label %in% c("<external_subject_id_1>", "<external_subject_id_2>"))

combined_data <- combined_data %>%
  group_by(subject_id, species, site_specific) %>%
  mutate(combined_type = ifelse(n_distinct(data_type) > 1, "Both", data_type)) %>%
  ungroup()

panel1_ecoli <- ggplot(combined_data, aes(x = subject_label, y = species)) +
  geom_point(aes(shape = combined_type), size = 5, color = "lightgreen") +
  facet_wrap(~ site_specific, labeller = as_labeller(c("Ic_Ax" = "Ic/Ax")), nrow = 1) +
  scale_shape_manual(
    values = c("MAG" = 16, "WGS" = 17, "Both" = 15),
    labels = c("MAG", "Isolate", "Both"),
    breaks = c("MAG", "WGS", "Both")
  ) +
  labs(
    x = "Subject ID",
    y = "Species"
  ) +
  theme_minimal(base_size = 11) +
  theme(
    legend.text = element_text(size = 9),
    legend.title = element_blank(),
    legend.box = "horizontal",
    legend.position = "bottom",
    axis.text.x = element_text(angle = 45, hjust = 1, size = 9),
    axis.text.y = element_text(face = "bold", size = 11),
    panel.background = element_rect(fill = "darkblue"),
    plot.background = element_rect(fill = "white"),
    panel.grid.major = element_line(color = "white", linetype = "dashed", linewidth = 0.8),
    panel.grid.minor = element_line(color = "white", linetype = "dashed", linewidth = 0.5),
    strip.background = element_rect(fill = "gray90"),
    strip.text = element_text(face = "bold", size = 10, color = "black"),
    plot.margin = margin(t = 10, r = 10, b = 10, l = 10)
  )

panel1_ecoli
```


# Figure 3B (made with python in jupyter notebook)
```
import pandas as pd
import matplotlib.pyplot as plt
import numpy as np

input_file = "<AMR_gene_metadata_table.csv>"  # AMR gene table corresponding to Supplementary Table S4
merged_df = pd.read_csv(input_file)

# Optional: exclude control or external subjects if present in the released table.
filtered_df = merged_df[
    ~merged_df["subject_id"].str.contains("<control_sample_keyword>", case=False, na=False)
    & (merged_df["subject_id"] != "<external_subject_id>")
].copy()

# Use anonymized subject IDs already provided in the released table.
filtered_df["subject_id_plot"] = filtered_df["subject_id"]

presence_absence = (
    filtered_df
    .pivot_table(
        index="AMR Gene Family",
        columns="subject_id_plot",
        aggfunc="size",
        fill_value=0
    )
    .applymap(lambda x: 1 if x > 0 else 0)
)

genes = presence_absence.index.tolist()
subjects = presence_absence.columns.tolist()

x, y = np.meshgrid(np.arange(len(subjects)), np.arange(len(genes)))

x_flat = x.flatten()
y_flat = y.flatten()
presence_flat = presence_absence.to_numpy().flatten()

colors = np.where(presence_flat == 1, "steelblue", "lightgray")
alphas = np.where(presence_flat == 1, 1.0, 0.3)

plt.figure(figsize=(20, 10))

for xi, yi, c, a in zip(x_flat, y_flat, colors, alphas):
    plt.scatter(
        xi,
        yi,
        s=300,
        color=c,
        alpha=a,
        edgecolor="gray",
        linewidth=0.5
    )

plt.xticks(
    np.arange(len(subjects)),
    subjects,
    rotation=45,
    ha="right",
    fontsize=10,
    fontweight="bold"
)

plt.yticks(
    np.arange(len(genes)),
    genes,
    fontsize=10,
    fontweight="bold"
)

plt.gca().invert_yaxis()
plt.xlabel("")
plt.ylabel("")
plt.grid(False)
plt.tight_layout()

